{{ include "../partials/header" }}

<form action="/session" method="POST" role="form" class="form-horizontal">
    <fieldset>
        <legend class="text-center"><i class="fa fa-sign-in">&nbsp;</i>Start Session</legend>
        <div class="form-group">
            <label for="date" class="col-xs-6 col-md-4 control-label">Date</label>
            <div class="col-xs-6 col-md-4">
                <input id="date" name="date" type="date" value="{{ request.Date }}" class="form-control" placeholder="Date" required>
            </div>
        </div>
        <div class="form-group">
            <label for="cashbox_value" class="col-xs-6 col-md-4 control-label">Cashbox Value</label>
            <div class="col-xs-6 col-md-4">
                <input id="cashbox_value" name="cashbox_value" type="number" value="{{ request.CashboxValue }}" class="form-control" placeholder="Cashbox Value" required>
            </div>
        </div>
        <div class="form-group">
            <label for="cashbox_note" class="col-xs-6 col-md-4 control-label">Cashbox Note</label>
            <div class="col-xs-6 col-md-4">
                <input id="cashbox_note" name="cashbox_note" type="text" value="{{ request.CashboxNote }}" class="form-control" placeholder="Cashbox Note">
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-6 col-md-4">&nbsp;</div>
            <div class="col-xs-6 col-md-4">
                <button type="submit" class="btn btn-primary">Submit</button>
                <button type="reset" class="btn btn-secondary">Reset</button>
            </div>
        </div>
    </fieldset>
</form>

{{ include "../partials/footer" }}
