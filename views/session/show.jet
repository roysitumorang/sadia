{{ include "../partials/header" }}

<h2 class="navbar-form navbar-left">Session {{ session.Date }}</h2>
<div class="clearfix"></div>
<form action="/session/{{ session.ID }}" method="POST" role="form" class="form-horizontal">
    <table class="table table-striped table-hover table-condensed">
        <thead>
            <tr>
                <th class="text-center">Status</th>
                <th class="text-center">Cashbox Value</th>
                <th class="text-center">Cashbox Note</th>
                <th class="text-center">Transaction Value</th>
                <th class="text-center">Spending Value</th>
                <th class="text-center">#</th>
            </tr>
        </thead>
        <tbody>
            <tr class="text-nowrap">
                <td>{{ if session.Status == 1 }}closed{{ else }}on going{{ end }}</td>
                <td>{{ session.CashboxValue | Comma }}</td>
                <td>{{ if session.CashboxNote }}{{ session.CashboxNote }}{{ else }}-{{ end }}</td>
                <td>{{ session.TransactionValue | Comma }}</td>
                <td>{{ session.SpendingValue | Comma }}</td>
                <td><button type="submit" class="btn btn-primary">Close</button></td>
            </tr>
        </tbody>
    </table>
</form>
<form action="/session/{{ session.ID }}/spending" method="POST" role="form" class="form-horizontal">
    <fieldset>
        <legend class="text-center">New Spending</legend>
        <div class="form-group">
            <label for="description" class="col-xs-6 col-md-4 control-label">Description</label>
            <div class="col-xs-6 col-md-4">
                <input id="description" name="description" type="text" value="{{ request.Description }}" class="form-control" placeholder="Description" required>
            </div>
        </div>
        <div class="form-group">
            <label for="value" class="col-xs-6 col-md-4 control-label">Value</label>
            <div class="col-xs-6 col-md-4">
                <input id="value" name="value" type="number" value="{{ request.Value }}" class="form-control" placeholder="Value" required>
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-6 col-md-4">&nbsp;</div>
            <div class="col-xs-6 col-md-4">
                <button type="submit" class="btn btn-primary">Submit</button>
                <button type="reset" class="btn btn-secondary">Reset</button>
            </div>
        </div>
    </fieldset>
</form>
<div class="clearfix"></div>
<h2 class="navbar-form navbar-left">Spending</h2>
<table class="table table-striped table-hover table-condensed">
    <thead>
        <tr>
            <th class="text-center">No</th>
            <th class="text-center">Description</th>
            <th class="text-center">Value</th>
        </tr>
    </thead>
    <tbody>
    {{ range i, item := session.Spendings }}
        <tr class="text-nowrap">
            <td>{{ i + 1 }}</td>
            <td>{{ item.Description }}</td>
            <td>{{ item.Value | Comma }}</td>
        </tr>
    {{ end }}
    </tbody>
</table>

{{ include "../partials/footer" }}
