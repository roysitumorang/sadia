{{ include "../partials/header" }}

<h2><a href="/transaction">Transaction</a> > Cart</h2>
<form method="POST" action="/transaction" role="form" class="form-horizontal">
    <fieldset>
        <table class="table table-striped table-hover table-condensed">
            <thead>
                <tr>
                    <th class="text-center">No</th>
                    <th class="text-center">Name</th>
                    <th class="text-center">Price</th>
                    <th class="text-center">Quantity</th>
                    <th class="text-center">Sub Total</th>
                    <th class="text-center">#</th>
                </tr>
            </thead>
            <tbody>
            {{ range i, item := request.LineItems }}
                <tr class="text-nowrap">
                    <td>
                        <input type="hidden" name="line_items[][product_id]" value="{{ item.ProductID }}">
                        {{ i + 1 }}
                    </td>
                    <td>{{ item.ProductName }}</td>
                    <td>{{ item.SellingPrice | Comma }}</td>
                    <td><input type="number" name="line_items[][quantity]" value="{{ item.Quantity }}" min="1" max="{{ item.Stock }}"></td>
                    <td>{{ item.SubTotal | Comma }}</td>
                    <td><a type="button" href="/transaction/cart/line-item/{{ item.ProductID }}/delete" class="btn btn-danger"><i class="fa fa-trash">&nbsp;</i>Remove</a></td>
                </tr>
            {{ end }}
            </tbody>
            <thead>
                <tr>
                    <th class="text-center">&nbsp;</th>
                    <th class="text-center">&nbsp;</th>
                    <th class="text-center">&nbsp;</th>
                    <th class="text-center">&nbsp;</th>
                    <th class="text-center">&nbsp;</th>
                    <th class="text-center">&nbsp;</th>
                </tr>
            </thead>
            <tbody>
                <tr class="text-nowrap">
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>Total</td>
                    <td>{{ request.SubTotal | Comma }}</td>
                    <td>&nbsp;</td>
                </tr>
                <tr class="text-nowrap">
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>Discount</td>
                    <td><input type="number" name="discount" value="{{ request.Discount }}"></td>
                    <td>&nbsp;</td>
                </tr>
                <tr class="text-nowrap">
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>Total</td>
                    <td>{{ request.Total | Comma }}</td>
                    <td>&nbsp;</td>
                </tr>
                <tr class="text-nowrap">
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <button type="reset" class="btn btn-secondary">Reset</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </fieldset>
</form>

{{ include "../partials/footer" }}
