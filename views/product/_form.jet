<fieldset>
    <div class="form-group">
        <label for="category_id" class="col-xs-6 col-md-4 control-label">Category</label>
        <div class="col-xs-6 col-md-4">
            <select name="category_id" class="form-select" id="category_id">
                <option value="">Choose...</option>
                {{ range _, item := productCategories }}
                    <option value="{{ item.ID }}"{{ if item.ID == categoryID }} selected{{ end }}>{{ item.Name }}</option>
                {{ end }}
            </select>
        </div>
    </div>
    <div class="form-group">
        <label for="name" class="col-xs-6 col-md-4 control-label">Name</label>
        <div class="col-xs-6 col-md-4">
            <input id="name" name="name" type="text" value="{{ request.Name }}" class="form-control" placeholder="Name" required>
        </div>
    </div>
    <div class="form-group">
        <label for="uom" class="col-xs-6 col-md-4 control-label">UOM</label>
        <div class="col-xs-6 col-md-4">
            <input type="text" name="uom" value="{{ request.UOM }}" class="form-control" id="uom" placeholder="UOM" autocomplete="off" />
        </div>
    </div>
    <div class="form-group">
        <label for="minimum_stock" class="col-xs-6 col-md-4 control-label">Minimum Stock</label>
        <div class="col-xs-6 col-md-4">
            <input type="number" name="minimum_stock" value="{{ request.MinimumStock }}" class="form-control" id="minimum_stock" placeholder="minimum stock" autocomplete="off" />
        </div>
    </div>
    <div class="form-group">
        <label for="stock" class="col-xs-6 col-md-4 control-label">Stock</label>
        <div class="col-xs-6 col-md-4">
            <input type="number" name="stock" value="{{ request.Stock }}" class="form-control" id="stock" placeholder="stock" autocomplete="off" />
        </div>
    </div>
    <div class="form-group">
        <label for="base_price" class="col-xs-6 col-md-4 control-label">Base Price</label>
        <div class="col-xs-6 col-md-4">
            <input type="number" name="base_price" value="{{ request.BasePrice }}" class="form-control" id="base_price" placeholder="base price" autocomplete="off" />
        </div>
    </div>
    <div class="form-group">
        <label for="selling_price" class="col-xs-6 col-md-4 control-label">Selling Price</label>
        <div class="col-xs-6 col-md-4">
            <input type="number" name="selling_price" value="{{ request.SellingPrice }}" class="form-control" id="selling_price" placeholder="selling price" autocomplete="off" />
        </div>
    </div>
    <div class="form-group">
        <label for="weight" class="col-xs-6 col-md-4 control-label">Weight (gram)</label>
        <div class="col-xs-6 col-md-4">
            <input type="number" name="weight" value="{{ request.Weight }}" class="form-control" id="weight" placeholder="Weight" autocomplete="off" />
        </div>
    </div>
    <div class="form-group">
        <label for="rack_position" class="col-xs-6 col-md-4 control-label">Rack Position</label>
        <div class="col-xs-6 col-md-4">
            <input type="text" name="rack_position" value="{{ request.RackPosition }}" class="form-control" id="rack_position" placeholder="rack position" autocomplete="off" />
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-6 col-md-4">&nbsp;</div>
        <div class="col-xs-6 col-md-4">
            <button type="submit" class="btn btn-primary">Submit</button>
            <button type="reset" class="btn btn-secondary">Reset</button>
        </div>
    </div>
</fieldset>
