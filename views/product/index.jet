{{ include "../partials/header" }}

<h2 class="navbar-form navbar-left">Product</h2>
<form method="GET" action="/product" class="navbar-form navbar-right" role="search" onsubmit="('Search'==$('[name=q').val())&amp;&amp;$('[name=q]').val('')">
    <input type="text" name="q" value="{{ q }}" class="form-control" placeholder="Search">
    <button type="submit" class="btn btn-default"><i class="fa fa-search">&nbsp;</i>Search</button>
    <a type="button" href="/product/new" class="btn btn-default"><i class="fa fa-user-plus">&nbsp;</i>New</a>
</form>
<table class="table table-striped table-hover table-condensed">
    <thead>
        <tr>
            <th scope="col">No</th>
            <th scope="col">Code</th>
            <th scope="col">Name</th>
            <th scope="col">Category</th>
            <th scope="col">UOM</th>
            <th scope="col">Minimum / Current Stock</th>
            <th scope="col">Base / Selling Price</th>
            <th scope="col">Weight</th>
            <th scope="col">Rack Position</th>
            <th scope="col">#</th>
        </tr>
    </thead>
    <tbody>
        {{ range _, item := rows }}
        <tr>
            <td>{{ item.RowNo }}</td>
            <td>{{ item.Code }}</td>
            <td>{{ item.Name }}</td>
            <td>{{ if item.CategoryName }}{{ item.CategoryName }}{{ else }}-{{ end }}</td>
            <td>{{ item.UOM }}</td>
            <td>{{ item.MinimumStock }} / {{ item.Stock }}</td>
            <td>{{ item.BasePrice | Comma }} / {{ item.SellingPrice | Comma }}</td>
            <td>{{ item.Weight }} gram</td>
            <td>{{ if item.RackPosition }}{{ item.RackPosition }}{{ else }}-{{ end }}</td>
            <td>
                <a type="button" href="/product/{{ item.ID }}/edit" class="btn btn-primary"><i class="fa fa-edit">&nbsp;</i>Edit</a>
                {{ if currentCompany.SessionID && item.Stock > 0 }}
                    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modal-{{ item.ID }}" data-whatever="@mdo"><i class="fa fa-cart-plus">&nbsp;</i>Add to Cart</button>
                    <div class="modal fade" id="modal-{{ item.ID }}" tabindex="-1" role="dialog" aria-labelledby="modal-label-{{ item.ID }}">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <form method="POST" action="/transaction/cart/line-item">
                                    <input type="hidden" name="product_id" value="{{ item.ID }}" id="product_id">
                                    <div class="modal-header">
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                        <h4 class="modal-title" id="modal-label-{{ item.ID }}">Add to Cart</h4>
                                    </div>
                                    <div class="modal-body">
                                        <div class="form-group">
                                            <label for="recipient-name" class="control-label">Name:</label>
                                            <input type="text" name="name" value="{{ item.Name }}" id="name" class="form-control" disabled="disabled">
                                        </div>
                                        <div class="form-group">
                                            <label for="quantity" class="control-label">Quantity:</label>
                                            <input type="number" name="quantity" value="1" id="quantity" class="form-control" min="1" max="{{ item.Stock }}">
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                        <button type="submit" class="btn btn-primary">Submit</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                {{ end }}
            </td>
        </tr>
        {{ end }}
    </tbody>
</table>
<form method="GET" action="/product" class="navbar-form navbar-right">
    <input type="hidden" name="q" value="{{ q }}">
    <i class="fa fa-sort-amount-asc">&nbsp;</i>&nbsp;Size per page&nbsp;:&nbsp;</strong>&nbsp;
    <select class="form-control" name="limit" onchange="$(this).closest('form').submit()">
        {{ range _, item := limits }}
        <option value="{{ item }}"{{ if pagination.Info.Limit == item }} selected{{ end }}>{{ item }}</option>
        {{ end }}
    </select>
</form>
{{ if pagination.Info.Total > pagination.Info.Limit }}
    <ul class="pagination">
        {{ if pagination.Links.First }}
            <li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
        {{ end }}
        {{ if pagination.Links.Previous }}
            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
        {{ end }}
        {{ if pagination.Links.Current }}
            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
        {{ end }}
        {{ if pagination.Links.Next }}
            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
        {{ end }}
        {{ if pagination.Links.Last }}
            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
        {{ end }}
        <li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
    </ul>
{{ end }}

{{ include "../partials/footer" }}
