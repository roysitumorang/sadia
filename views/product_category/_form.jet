<fieldset>
    <div class="form-group">
        <label for="name" class="col-xs-6 col-md-4 control-label">Name</label>
        <div class="col-xs-6 col-md-4"><input id="name" name="name" type="text" value="{{ request.Name }}" class="form-control" placeholder="Name"></div>
    </div>
    <div class="form-group">
        <label for="slug" class="col-xs-6 col-md-4 control-label">Slug</label>
        <div class="col-xs-6 col-md-4"><input id="slug" name="slug" type="text" value="{{ request.Slug }}" class="form-control" placeholder="Slug"></div>
    </div>
    <div class="form-group">
        <div class="col-xs-6 col-md-4">&nbsp;</div>
        <div class="col-xs-6 col-md-4">
            <button type="submit" class="btn btn-primary">Submit</button>
            <button type="reset" class="btn btn-secondary">Reset</button>
        </div>
    </div>
</fieldset>
